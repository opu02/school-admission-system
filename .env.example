# Copy to `.env` to override defaults used by docker-compose.yml.
# None of these are required — `docker compose up` works without a .env file.

POSTGRES_DB=school_admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=admission

# How long (seconds) a seat stays HELD before it is released automatically.
HOLD_DURATION_SECONDS=600

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
